# Mesa settings. Copy to .env.local (gitignored). No Slack or Basecamp credentials:
# those are reached only through Claude's MCP connectors. GitHub uses the gh CLI login.

# Phone access: a Cloudflare Tunnel (cloudflared, `pnpm tunnel`) behind a Cloudflare Access app that only lets your
# email in. Mesa checks two keys on every request that comes through the tunnel: the Access login (verified here)
# and its own token. Missing any of the five values below and every tunnel request is refused. Setup: docs/ARCHITECTURE.md § 11.

# Second key: long random string. Never put it in a URL or a chat: the phone gets it by scanning the one-time QR on
# /telefono (or typing its short code).
MESA_TOKEN=

# Where the phone connects: https://mesa.<your domain>, the hostname the tunnel publishes (the QR link is built from it).
MESA_PUBLIC_URL=

# First key, from your Cloudflare Zero Trust dashboard: the team domain (<team>.cloudflareaccess.com), the Access
# application's AUD tag (Access > Applications > Mesa > Overview), and the one email allowed in.
MESA_CF_ACCESS_TEAM=
MESA_CF_ACCESS_AUD=
MESA_CF_ACCESS_EMAIL=

# Name of the named tunnel (default: mesa). `pnpm tunnel` writes its config to ~/.cloudflared, never into the repo.
MESA_CF_TUNNEL=

# `pnpm start` starts the tunnel as a child of the board when MESA_PUBLIC_URL and MESA_CF_TUNNEL are set. MESA_TUNNEL=off
# disables that; MESA_TUNNEL=on also starts it under `pnpm dev`.
MESA_TUNNEL=

# Address the board binds to (default 127.0.0.1: nothing on the LAN reaches :8790). The phone comes in through
# `pnpm tunnel` (cloudflared on this PC). Setting 0.0.0.0 opens the port to the LAN: do not.
MESA_HOST=

# SQLite file (default: data/mesa.db)
MESA_DB=

# Session id of the lead Claude session that owns every ticket (default: lead)
MESA_LEAD_SESSION=

# Used by bin/mesa and scripts/hooks/mesa-approval.mjs (default: http://127.0.0.1:8790)
MESA_URL=

# PermissionRequest hook wait before denying (default: 540000 ms; keep under the hook timeout)
MESA_APPROVAL_TIMEOUT_MS=

# "Abrir destino" on a salida card links to where it will be published. Slack and Basecamp need two values Mesa
# cannot read from the destination; without them (and without an origin link of the same place) no link is shown.
# Slack workspace subdomain: designli for designli.slack.com
MESA_SLACK_DOMAIN=
# Basecamp account id: the number in https://3.basecamp.com/<account>/
MESA_BASECAMP_ACCOUNT=

# "Abrir conversación" on a Slack salida opens the Slack app with slack://channel?team=<id>&id=<channel>. It needs the
# workspace's team id (T0…; Slack > workspace menu > Settings, or any Slack URL of the form …/client/T0…/). Optional: without
# it the button opens https://<MESA_SLACK_DOMAIN>.slack.com/archives/<channel> in the browser instead. Not a secret: Mesa holds no Slack token.
MESA_SLACK_TEAM_ID=

# Web Push to the phone with the app closed (src/lib/push). Print a fresh pair with `pnpm push:keys`, paste the three
# lines into .env.local (never into the repo) and restart Mesa. Without them push is off and /telefono says so.
# The subject is a contact for the push services: mailto:<email> or an https:// URL.
MESA_VAPID_PUBLIC_KEY=
MESA_VAPID_PRIVATE_KEY=
MESA_VAPID_SUBJECT=

# Tokens spent (Uso, /uso) are read from Claude Code's transcripts, so Mesa must see CLAUDE_CONFIG_DIR (default
# ~/.claude) or MESA_TRANSCRIPTS_DIR. By default the folder is the parent of this repo (its designli-sandbox sibling on the
# sandbox board); set MESA_SESSIONS_DIR to name the sessions folder, or MESA_TRANSCRIPTS_DIR to point at the transcripts folder itself.
MESA_SESSIONS_DIR=
MESA_TRANSCRIPTS_DIR=
