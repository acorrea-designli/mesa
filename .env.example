# Mesa settings. Copy to .env.local (gitignored). No Slack or Basecamp credentials:
# those are reached only through Claude's MCP connectors. GitHub uses the gh CLI login.

# Calendario: the SECRET address of your Google Calendar's iCal feed (Google Calendar > Settings > your calendar >
# "Secret address in iCal format"). The server polls it about every 5 min, read only. Anyone with it can read your
# calendar: it goes only here (.env.local, gitignored), never in the repo, a log, a ticket or a chat. Empty = the
# Calendario screen says "sin conectar". Never read in the sandbox.
MESA_GCAL_ICS_URL=

# Optional: your own calendar address, so Mesa reads your accept/decline answer on each meeting (declined meetings never
# remind) and builds the "Abrir en Google" link of each event. Default: the calendar name in the feed when it is an address;
# without either, the link opens the event's day.
MESA_GCAL_OWNER_EMAIL=

# MESA_CALENDAR=off stops the poller even when the address is set.
MESA_CALENDAR=

# Phone access: a Cloudflare Tunnel (cloudflared, `pnpm tunnel`) behind a Cloudflare Access app that only lets your
# email in. Mesa checks two keys on every request that comes through the tunnel: the Access login (verified here)
# and its own token. Missing any of the five values below and every tunnel request is refused. Setup: docs/ARCHITECTURE.md § 11.

# Second key: long random string. Never put it in a URL or a chat: the phone gets it by scanning the one-time QR on
# /telefono (or typing its short code).
MESA_TOKEN=

# Where the phone connects: https://mesa.<your domain>, the hostname the tunnel publishes (the QR link is built from it).
MESA_PUBLIC_URL=

# First key, from your Cloudflare Zero Trust dashboard: the team domain (<team>.cloudflareaccess.com), the Access
# application's AUD tag (Access > Applications > Mesa > Overview), and the one email allowed in.
MESA_CF_ACCESS_TEAM=
MESA_CF_ACCESS_AUD=
MESA_CF_ACCESS_EMAIL=

# Name of the named tunnel (default: mesa). `pnpm tunnel` writes its config to ~/.cloudflared, never into the repo.
MESA_CF_TUNNEL=

# `pnpm start` starts the tunnel as a child of the board when MESA_PUBLIC_URL and MESA_CF_TUNNEL are set. MESA_TUNNEL=off
# disables that; MESA_TUNNEL=on also starts it under `pnpm dev`.
MESA_TUNNEL=

# Address the board binds to (default 127.0.0.1: nothing on the LAN reaches :8790). The phone comes in through
# `pnpm tunnel` (cloudflared on this PC). Setting 0.0.0.0 opens the port to the LAN: do not.
MESA_HOST=

# SQLite file (default: data/mesa.db)
MESA_DB=

# Session id of the lead Claude session that owns every ticket (default: lead)
MESA_LEAD_SESSION=

# Used by bin/mesa and scripts/hooks/mesa-approval.mjs (default: http://127.0.0.1:8790)
MESA_URL=

# PermissionRequest hook wait before denying (default: 540000 ms; keep under the hook timeout). Read by the hook, so
# shell or the team's .claude/settings.json env only, not .env.local
MESA_APPROVAL_TIMEOUT_MS=

# "Abrir destino" on a salida card links to where it will be published. Slack and Basecamp need two values Mesa
# cannot read from the destination; without them (and without an origin link of the same place) no link is shown.
# Slack workspace subdomain: designli for designli.slack.com
MESA_SLACK_DOMAIN=
# Basecamp account id: the number in https://3.basecamp.com/<account>/
MESA_BASECAMP_ACCOUNT=

# "Abrir conversación" on a Slack salida opens the Slack app with slack://channel?team=<id>&id=<channel>. It needs the
# workspace's team id (T0…; Slack > workspace menu > Settings, or any Slack URL of the form …/client/T0…/). Optional: without
# it the button opens https://<MESA_SLACK_DOMAIN>.slack.com/archives/<channel> in the browser instead. Not a secret: Mesa holds no Slack token.
MESA_SLACK_TEAM_ID=

# Web Push to the phone with the app closed (src/lib/push). Print a fresh pair with `pnpm push:keys`, paste the three
# lines into .env.local (never into the repo) and restart Mesa. Without them push is off and /telefono says so.
# The subject is a contact for the push services: mailto:<email> or an https:// URL.
MESA_VAPID_PUBLIC_KEY=
MESA_VAPID_PRIVATE_KEY=
MESA_VAPID_SUBJECT=

# Tokens spent (Uso, /uso) are read from Claude Code's transcripts, so Mesa must see CLAUDE_CONFIG_DIR (default
# ~/.claude) or MESA_TRANSCRIPTS_DIR. By default the folder is the parent of this repo (its designli-sandbox sibling on the
# sandbox board); set MESA_SESSIONS_DIR to name the sessions folder, or MESA_TRANSCRIPTS_DIR to point at the transcripts folder itself.
MESA_SESSIONS_DIR=
MESA_TRANSCRIPTS_DIR=

# ---- Who this board belongs to and where its team lives. Every one defaults to the original owner's value, so leave it
# blank only on that machine: on any other, set MESA_GH_USER, MESA_GIT_NAME, MESA_GIT_EMAIL, MESA_SLACK_USER_ID and
# MESA_SESSIONS_DIR (the team commits and syncs as these identities).

# GitHub login Mesa reads and writes as. Its token comes from the gh CLI keyring for this account (`gh auth status`
# must list it); the active gh account does not matter. Default: acorrea-designli
MESA_GH_USER=

# Name and email the team's agents commit with (git user.name / user.email on every commit). Defaults: acorrea-designli, andres.correa@designli.co
MESA_GIT_NAME=
MESA_GIT_EMAIL=

# Your Slack member id (profile > ⋯ > Copy member ID, U0…). The Mesa server never reads it: install-team renders it into
# the sweeper's skill and agent (and writes it to the team's settings.json env), and scripts/sweep-tick.mjs lets it
# override sources.slack.userId of config/sweep.json. Default: the original owner's id
MESA_SLACK_USER_ID=

# MESA_SESSIONS_DIR above is the folder the Claude Code sessions of this board run in (the parent of this repo). Set it on any
# other machine: "Permitir esta regla" writes <folder>/.claude/settings.local.json and the worktrees folder defaults to
# "<folder>-wt". Default: G:/WorkSpace/designli

# Where the team's worktrees live (one folder per dev-<ticket>). Default: <sessions folder>-wt, G:/WorkSpace/designli-wt
MESA_WORKTREES_ROOT=

# "Permitir esta vez" on a denied command or MCP call: the denied hook touches this file after you allow, and the rails hook asks
# Mesa for the one-shot grant only while it is under 6 minutes old. Default: <tmp folder>/mesa-grant-hint (tests only)
MESA_GRANT_HINT=

# The settings.local.json that "Permitir esta regla" on an auto-mode card appends its allow rule to. Default:
# <sessions folder>/.claude/settings.local.json
MESA_SETTINGS_LOCAL=

# ---- Integrations and run mode

# GitHub sync (notifications, review requests, the "Mesa" Project). Default: on for the real board (MESA_DB unset), off on any
# scratch MESA_DB. MESA_GITHUB=on|off forces it. With no gh token for MESA_GH_USER the worker logs one line and stays off.
MESA_GITHUB=

# Title of the private GitHub Project the board mirrors to (default: Mesa). Mesa finds it by this title under MESA_GH_USER
# and creates it on the first sync when it is missing.
MESA_GH_PROJECT_TITLE=

# Session id the sweeper agent runs as, which the board sends sweep requests to (default: sweeper)
MESA_SWEEPER_SESSION=

# State files of two local watchers Mesa reads for the PR deck and the PR monitor (defaults: ~/.claude-work/gh-watch-state.json
# and ~/.claude-work/pr-monitor-state.json). Only set them when your watchers write somewhere else.
MESA_GH_WATCH_STATE=
MESA_PR_MONITOR_STATE=

# Port `pnpm start` / `pnpm dev` listen on (default 8790). Shell only: scripts/serve.mjs reads it before .env.local is
# loaded, so a value here has no effect; set it in the environment (MESA_PORT=8800 pnpm start). Use another one for a
# second board or a test clone.
MESA_PORT=

# The Mesa checkout the team hooks name when they tell an agent which CLI to run (`node <checkout>/bin/mesa`), and the
# the place the mesa-write skill looks for Playwright (<checkout>/node_modules) right after MESA_PLAYWRIGHT. Default: the
# checkout the hooks live in, which is right on any normal install. Shell or the team's .claude/settings.json env only:
# the hooks do not read .env.local.
MESA_REPO=

# Hook tuning (shell or the team's .claude/settings.json env only; the hooks do not read .env.local). Defaults are right
# for a normal install: MESA_APPROVAL_TIMEOUT_MS above, MESA_APPROVAL_POLL_MS (2000) and MESA_DENIED_POLL_MS (2000) are how
# often the permission hooks ask Mesa whether you decided, MESA_DENIED_TIMEOUT_MS (120000, under the denied hook's 150 s
# timeout) is how long the denied hook waits, MESA_HANDOFF_FRESH_MIN (15) is how recent a handoff must be for DONE.
MESA_APPROVAL_POLL_MS=
MESA_DENIED_POLL_MS=
MESA_DENIED_TIMEOUT_MS=
MESA_HANDOFF_FRESH_MIN=

# 1 routes the lead's own permission prompts and denied calls to Mesa too (the ticket named by `mesa lead focus <ref>`, else
# Hoy, Permisos); without it they stay in the lead's terminal. install-team writes MESA_APPROVAL_LEAD=1 into the team's
# .claude/settings.json env (never overwriting a value that is there), so you do not set it here. Hooks read it from that env.
MESA_APPROVAL_LEAD=

# Path or name of the engram binary Mesa runs to read memory (default: engram, on PATH)
MESA_ENGRAM_BIN=

# Playwright that renders client PDFs (mesa-write): the path to playwright's index.mjs. Optional, and tried first: without
# it the skill tries <MESA_REPO>/node_modules, then the repo's own node_modules, then the original owner's install. Leave
# the line commented unless you set a path.
# MESA_PLAYWRIGHT=

# MESA_ENV=sandbox runs the dummy board where nothing leaves (docs/SANDBOX.md). Default: live.
MESA_ENV=

# on|off: whether a new PR review request opens its review ticket by itself (default: config/sweep.json autoDispatch, on)
MESA_AUTO_DISPATCH=

