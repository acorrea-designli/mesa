{
  "name": "mesa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "mesa": "bin/mesa"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 8790",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 8790",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && pnpm test:team",
    "test:team": "node --test \"scripts/hooks/test/*.test.mjs\" \"scripts/test/*.test.mjs\"",
    "test:watch": "vitest",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "seed": "node --experimental-strip-types scripts/seed.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "motion": "14.9.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
