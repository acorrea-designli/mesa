{
  "name": "mesa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "mesa": "bin/mesa"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs dev",
    "build": "next build",
    "start": "node scripts/serve.mjs start",
    "tunnel": "node scripts/tunnel.mjs",
    "push:keys": "node scripts/push-keys.mjs",
    "tone:render": "node --experimental-strip-types scripts/render-hoy-tone.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && pnpm test:team",
    "test:team": "node --test \"scripts/hooks/test/*.test.mjs\" \"scripts/test/*.test.mjs\"",
    "test:watch": "vitest",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "seed": "node --experimental-strip-types scripts/seed.ts",
    "sandbox": "node scripts/sandbox.mjs",
    "sandbox:reset": "node --experimental-strip-types scripts/sandbox-reset.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "motion": "14.9.0",
    "next": "16.4.5",
    "pdfjs-dist": "6.5.438",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "web-push": "4.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "3.6.4",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
