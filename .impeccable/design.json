        "value": "1.6s cubic-bezier(.16,1,.3,1)",
        "purpose": "A tick or dot travelling along its line (status change, sync, Claude listening)."
      },
      {
        "name": "reduced-motion",
        "value": "animation: none",
        "purpose": "Under prefers-reduced-motion the tick jumps to its station."
      }
    ],
    "lineLanguage": {
      "stroke": "6px, round caps and joins",
      "bends": "45 and 90 degrees only",
      "dimmed": "about 35% opacity",
      "capsule": "ground fill, 2.5px ink outline; selected: porcelain fill, 3.5px outline",
      "tick": "r5, source fill, 1.6px ink stroke",
