      "html": "<span class=\"ds-st you\">Te espera</span> <span class=\"ds-st ok\">Limpio</span> <span class=\"ds-st\">Espera al cliente</span>",
      "css": ":root{--gnd:#eceae5;--deep:#e2dfd8;--raise:#fbfaf7;--rule:#d3cfc5;--rule2:#dcd8cf;--edge:#c3beb2;--ink:#1c1d21;--ink2:#3e4047;--mute:#5d5f68;--gh:#e60012;--sl:#00a3a8;--cl:#f39700;--bc:#00b07c;--bc-ink:#006b4d;--sl-tint:#e6f6f5;--gh-tint:#fbe6e5;--shade:rgba(28,29,33,.10)} .ds-st{font-family:\"Hanken Grotesk\",sans-serif;height:24px;padding:0 9px;border-radius:4px;display:inline-flex;align-items:center;font-size:12px;font-weight:700;border:1px solid var(--edge);color:var(--ink)} .ds-st.you{background:var(--ink);color:var(--gnd);border-color:var(--ink)} .ds-st.ok{border-color:var(--bc);color:var(--bc-ink)}"
    },
    {
      "name": "Destination Chips",
      "kind": "chip",
      "refersTo": "destination-chip-slack",
      "description": "Exact destination chips in the source line ink over its tint.",
      "html": "<div class=\"ds-dest\"><span class=\"ds-chip\">#scout-dev</span><span class=\"ds-chip\">Hilo 09:31 · Matt</span><span class=\"ds-chip gh\">PR #212</span></div>",
      "css": ":root{--gnd:#eceae5;--deep:#e2dfd8;--raise:#fbfaf7;--rule:#d3cfc5;--rule2:#dcd8cf;--edge:#c3beb2;--ink:#1c1d21;--ink2:#3e4047;--mute:#5d5f68;--gh:#e60012;--sl:#00a3a8;--cl:#f39700;--bc:#00b07c;--bc-ink:#006b4d;--sl-tint:#e6f6f5;--gh-tint:#fbe6e5;--shade:rgba(28,29,33,.10)} .ds-dest{display:flex;gap:6px;flex-wrap:wrap} .ds-chip{font-family:\"Hanken Grotesk\",sans-serif;border:1px solid var(--sl);border-radius:4px;padding:4px 9px;font-weight:600;font-size:13px;background:var(--sl-tint);color:var(--ink)} .ds-chip.gh{border-color:var(--gh);background:var(--gh-tint)}"
    },
    {
      "name": "Exact-Text Block",
      "kind": "custom",
      "refersTo": "exact-text-block",
      "description": "The outgoing message exactly as sent; the source line enters from the top as a stub.",
      "html": "<div class=\"ds-msg\">Confirmed, SCOUT_API_URL is set on staging. Prod after 2pm.</div>",
      "css": ":root{--gnd:#eceae5;--deep:#e2dfd8;--raise:#fbfaf7;--rule:#d3cfc5;--rule2:#dcd8cf;--edge:#c3beb2;--ink:#1c1d21;--ink2:#3e4047;--mute:#5d5f68;--gh:#e60012;--sl:#00a3a8;--cl:#f39700;--bc:#00b07c;--bc-ink:#006b4d;--sl-tint:#e6f6f5;--gh-tint:#fbe6e5;--shade:rgba(28,29,33,.10)} .ds-msg{font-family:\"Hanken Grotesk\",sans-serif;position:relative;margin-top:10px;background:var(--raise);border:1px solid var(--rule);border-radius:6px;padding:16px 16px 14px;font-size:16px;line-height:1.5;font-weight:500;color:var(--ink)} .ds-msg::before{content:\"\";position:absolute;left:15px;top:-4px;width:30px;height:7px;border-radius:4px;background:var(--sl)}"
    },
    {
      "name": "Board Card",
      "kind": "card",
      "refersTo": "board-card",
      "description": "Kanban card: line stub, project, time, two-line title, excerpt, wait tag.",
      "html": "<article class=\"ds-card\" tabindex=\"0\"><div class=\"top\"><span class=\"ln\"></span>prospec-admin<time>09:02</time></div><h3>feat: bulk export</h3><p>Review solicitado · +418 −36</p><span class=\"ds-st2\">Te espera</span></article>",
      "css": ":root{--gnd:#eceae5;--deep:#e2dfd8;--raise:#fbfaf7;--rule:#d3cfc5;--rule2:#dcd8cf;--edge:#c3beb2;--ink:#1c1d21;--ink2:#3e4047;--mute:#5d5f68;--gh:#e60012;--sl:#00a3a8;--cl:#f39700;--bc:#00b07c;--bc-ink:#006b4d;--sl-tint:#e6f6f5;--gh-tint:#fbe6e5;--shade:rgba(28,29,33,.10)} .ds-card{font-family:\"Hanken Grotesk\",sans-serif;width:220px;background:var(--raise);border:1px solid var(--rule);border-radius:6px;padding:10px 12px 11px;display:flex;flex-direction:column;gap:5px;color:var(--ink);transition:box-shadow .2s,border-color .2s} .ds-card:hover{border-color:var(--edge);box-shadow:0 2px 8px var(--shade)} .ds-card:focus-visible{outline:2px solid var(--ink);outline-offset:2px} .ds-card .top{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--mute);font-weight:600} .ds-card .top time{margin-left:auto;font-variant-numeric:tabular-nums} .ds-card .ln{width:22px;height:5px;border-radius:3px;background:var(--gh)} .ds-card h3{font-size:14px;font-weight:600;line-height:1.3;margin:0} .ds-card p{font-size:12.5px;color:var(--mute);margin:0} .ds-st2{align-self:flex-start;height:22px;padding:0 9px;border-radius:4px;display:inline-flex;align-items:center;font-size:12px;font-weight:700;background:var(--ink);color:var(--gnd)}"
    },
    {
      "name": "Line Band",
      "kind": "custom",
      "refersTo": "line-band",
      "description": "Signature: source lines through station capsules; selected station solid, the rest at about 35%.",
      "html": "<svg class=\"ds-band\" width=\"420\" height=\"120\" viewBox=\"0 0 420 120\" aria-hidden=\"true\"><g fill=\"none\" stroke-width=\"6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" opacity=\".35\"><path d=\"M20 40H220l20-20H400\" stroke=\"var(--gh)\"/><path d=\"M20 60H400\" stroke=\"var(--sl)\"/><path d=\"M20 80H400\" stroke=\"var(--cl)\"/></g><g fill=\"none\" stroke-width=\"6\" stroke-linecap=\"round\"><path d=\"M20 40H130\" stroke=\"var(--gh)\"/><path d=\"M20 60H130\" stroke=\"var(--sl)\"/><path d=\"M20 80H130\" stroke=\"var(--cl)\"/></g><rect x=\"110\" y=\"18\" width=\"34\" height=\"84\" rx=\"17\" fill=\"var(--raise)\" stroke=\"var(--ink)\" stroke-width=\"3.5\"/><rect x=\"300\" y=\"18\" width=\"34\" height=\"84\" rx=\"17\" fill=\"var(--gnd)\" stroke=\"var(--ink)\" stroke-width=\"2.5\" opacity=\".85\"/><circle cx=\"60\" cy=\"40\" r=\"5\" fill=\"var(--gh)\" stroke=\"var(--ink)\" stroke-width=\"1.6\"/><circle cx=\"80\" cy=\"60\" r=\"5\" fill=\"var(--sl)\" stroke=\"var(--ink)\" stroke-width=\"1.6\"/><circle cx=\"90\" cy=\"40\" r=\"8.5\" fill=\"var(--raise)\" stroke=\"var(--ink)\" stroke-width=\"3\"/></svg>",
      "css": ":root{--gnd:#eceae5;--deep:#e2dfd8;--raise:#fbfaf7;--rule:#d3cfc5;--rule2:#dcd8cf;--edge:#c3beb2;--ink:#1c1d21;--ink2:#3e4047;--mute:#5d5f68;--gh:#e60012;--sl:#00a3a8;--cl:#f39700;--bc:#00b07c;--bc-ink:#006b4d;--sl-tint:#e6f6f5;--gh-tint:#fbe6e5;--shade:rgba(28,29,33,.10)} .ds-band{display:block;background:var(--gnd)}"
    }
  ],
  "narrative": {
    "northStar": "Mapa de metro",
    "overview": "The working day is a transit network. Each source is a coloured line (GitHub, Slack, Claude, Basecamp), each status is a station (Inbox, Todo, En curso, Esperando, Hecho), and each item is a tick riding its line. The signature is the line band across the top of the work area: picking a station or a source filter re-routes it, so the chosen line burns at full ink and the rest drop to about 35%. Everything below the band is a dense, calm operating surface: rows that read in one glance, a detail pane, and an approval that shows exact destination and exact text before anything is signed.\n\nThe material is signage, not software chrome. Grounds are warm paper greys in the light \"Tokio\" theme (the default) and graphite in the dark \"Grafito\" theme. Station capsules have a ground fill and an ink outline, interchanges are open rings, and lines bend only at 45 and 90 degrees. One humanist sans, Hanken Grotesk, carries everything at fixed sizes with tabular numerals, like a station board.\n\nColour is reserved for wayfinding. The four line inks identify a source and nothing else; state is carried by ink weight, fill, dashes and dotted lines, never by a semantic red or green.",
    "keyCharacteristics": [
      "Two themes from one token set: Tokio light on `:root`, Grafito dark on `[data-theme=\"dark\"]`.",
      "Four line inks that mean source only; Slack is teal in both themes.",
      "Station capsules, open interchange rings, 45/90 degree bends, 6px round-capped strokes.",
      "One family, fixed sizes, tabular numerals for every count and time.",
      "Flat surfaces separated by hairline rules and tonal grounds; shadow only for floating layers."
    ],
    "rules": [
      {
        "name": "The Lines Carry Source Rule",
        "body": "A line ink identifies GitHub, Slack, Claude or Basecamp and nothing else. It is never an error, warning, success or diff colour; red is GitHub.",
        "section": "colors"
      },
      {
        "name": "The Mute Is Text Rule",
        "body": "Secondary copy uses `mute`. `dim` stays in the palette for non-text marks only, and station counts use `mute` rather than opacity.",
        "section": "colors"
      },
      {
        "name": "The One Solid Tag Rule",
        "body": "\"Te espera\" (and \"Por enviar\") is the only solid-ink status tag. Every other status is an outline.",
        "section": "colors"
      },
      {
        "name": "The Fixed Board Rule",
        "body": "Sizes are fixed px, never fluid. Every time, count and ID uses tabular numerals.",
        "section": "typography"
      },
      {
        "name": "The Flat Board Rule",
        "body": "Rows, panes and cards rest flat on tonal grounds. A shadow means \"this floats\" or \"you are pointing at it\".",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use the four line inks only to identify a source, at full strength on the chosen line and about 35% on the rest.",
      "**Do** set secondary text in `mute`; keep `dim` for non-text marks.",
      "**Do** show the exact destination and the exact text in the same view as Aprobar, and mark the text block with a top line stub in the destination's ink.",
      "**Do** draw lines with 6px round-capped strokes that bend only at 45 or 90 degrees, with interchange rings for items linked to two sources.",
      "**Do** express outages with dotted lines and a 45 degree slash, and show edits as strike (removed) and underline (added) without colour.",
      "**Do** keep every view working in both Tokio and Grafito through the tokens; Slack stays teal in both."
    ],
    "donts": [
      "**Don't** use red, green or orange as error, success or warning colours; red is GitHub, green is Basecamp, orange is Claude.",
      "**Don't** make any status tag solid ink except \"Te espera\" / \"Por enviar\".",
      "**Don't** split Claude-asks and Andrés-asks into separate column sets; direction is a line-into-ring marker on the row.",
      "**Don't** put `dim` on text, and don't fade station counts with opacity.",
      "**Don't** mark the exact-text block with a side border; the stub enters from the top."
    ]
  }
}
