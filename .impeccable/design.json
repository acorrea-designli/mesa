  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Solid ink action: Aprobar y enviar, Responder.",
      "html": "<button class=\"ds-btn ds-btn-p\">Aprobar y enviar</button>",
      "css": ":root{--gnd:#eceae5;--deep:#e2dfd8;--raise:#fbfaf7;--rule:#d3cfc5;--rule2:#dcd8cf;--edge:#c3beb2;--ink:#1c1d21;--ink2:#3e4047;--mute:#5d5f68;--gh:#e60012;--sl:#00a3a8;--cl:#f39700;--bc:#00b07c;--bc-ink:#006b4d;--sl-tint:#e6f6f5;--gh-tint:#fbe6e5;--shade:rgba(28,29,33,.10)} .ds-btn{font-family:\"Hanken Grotesk\",sans-serif;height:40px;padding:0 16px;border-radius:6px;display:inline-flex;align-items:center;font-weight:600;font-size:14px;border:1px solid var(--edge);background:transparent;color:var(--ink);cursor:pointer} .ds-btn-p{background:var(--ink);color:var(--gnd);border-color:var(--ink)} .ds-btn-p:hover{background:var(--ink2);border-color:var(--ink2)} .ds-btn:focus-visible{outline:2px solid var(--ink);outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Outline action: Editar, Denegar.",
      "html": "<button class=\"ds-btn2\">Editar</button>",
      "css": ":root{--gnd:#eceae5;--deep:#e2dfd8;--raise:#fbfaf7;--rule:#d3cfc5;--rule2:#dcd8cf;--edge:#c3beb2;--ink:#1c1d21;--ink2:#3e4047;--mute:#5d5f68;--gh:#e60012;--sl:#00a3a8;--cl:#f39700;--bc:#00b07c;--bc-ink:#006b4d;--sl-tint:#e6f6f5;--gh-tint:#fbe6e5;--shade:rgba(28,29,33,.10)} .ds-btn2{font-family:\"Hanken Grotesk\",sans-serif;height:40px;padding:0 16px;border-radius:6px;display:inline-flex;align-items:center;font-weight:600;font-size:14px;border:1px solid var(--edge);background:transparent;color:var(--ink);cursor:pointer} .ds-btn2:hover{background:var(--raise)} .ds-btn2:focus-visible{outline:2px solid var(--ink);outline-offset:2px}"
    },
    {
      "name": "Source Tabs",
      "kind": "nav",
      "refersTo": "tab",
      "description": "Source filter tabs; active is solid ink, others carry an 8px source dot.",
      "html": "<div class=\"ds-tabs\"><button class=\"ds-tab on\">Todo 9</button><button class=\"ds-tab\"><u style=\"background:var(--gh)\"></u>GitHub 4</button><button class=\"ds-tab\"><u style=\"background:var(--sl)\"></u>Slack 2</button></div>",
      "css": ":root{--gnd:#eceae5;--deep:#e2dfd8;--raise:#fbfaf7;--rule:#d3cfc5;--rule2:#dcd8cf;--edge:#c3beb2;--ink:#1c1d21;--ink2:#3e4047;--mute:#5d5f68;--gh:#e60012;--sl:#00a3a8;--cl:#f39700;--bc:#00b07c;--bc-ink:#006b4d;--sl-tint:#e6f6f5;--gh-tint:#fbe6e5;--shade:rgba(28,29,33,.10)} .ds-tabs{display:flex;gap:6px} .ds-tab{font-family:\"Hanken Grotesk\",sans-serif;height:30px;padding:0 12px;display:flex;align-items:center;gap:7px;border:1px solid var(--rule);border-radius:6px;background:transparent;color:var(--ink2);font-weight:600;font-size:13px;cursor:pointer;font-variant-numeric:tabular-nums} .ds-tab u{width:8px;height:8px;border-radius:50%} .ds-tab:hover{border-color:var(--edge)} .ds-tab.on{background:var(--ink);color:var(--gnd);border-color:var(--ink)} .ds-tab:focus-visible{outline:2px solid var(--ink);outline-offset:2px}"
    },
    {
      "name": "Rail Navigation",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "Left rail items with tabular counts; active item on porcelain.",
      "html": "<nav class=\"ds-rail\"><a class=\"ds-nav on\" href=\"#\">Hoy <b>9</b></a><a class=\"ds-nav\" href=\"#\">Tablero <b>22</b></a><a class=\"ds-nav\" href=\"#\">Tickets <b>4</b></a><a class=\"ds-nav\" href=\"#\">Salidas <b>3</b></a></nav>",
      "css": ":root{--gnd:#eceae5;--deep:#e2dfd8;--raise:#fbfaf7;--rule:#d3cfc5;--rule2:#dcd8cf;--edge:#c3beb2;--ink:#1c1d21;--ink2:#3e4047;--mute:#5d5f68;--gh:#e60012;--sl:#00a3a8;--cl:#f39700;--bc:#00b07c;--bc-ink:#006b4d;--sl-tint:#e6f6f5;--gh-tint:#fbe6e5;--shade:rgba(28,29,33,.10)} .ds-rail{width:184px;background:var(--deep);padding:14px;display:flex;flex-direction:column;gap:3px} .ds-nav{font-family:\"Hanken Grotesk\",sans-serif;display:flex;justify-content:space-between;align-items:center;height:38px;padding:0 10px;border-radius:6px;color:var(--ink2);font-weight:600;font-size:14px;text-decoration:none} .ds-nav b{font-weight:600;font-size:13px;color:var(--mute);font-variant-numeric:tabular-nums} .ds-nav:hover{color:var(--ink)} .ds-nav.on{background:var(--raise);color:var(--ink)} .ds-nav.on b{color:var(--ink)} .ds-nav:focus-visible{outline:2px solid var(--ink);outline-offset:2px}"
    },
