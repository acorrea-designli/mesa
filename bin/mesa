#!/usr/bin/env node
// mesa: the CLI Claude Code sessions use to talk to the Mesa board.
// Thin wrapper over the REST API (docs/ARCHITECTURE.md). No dependencies.
//
//   MESA_URL      board URL (default http://127.0.0.1:8790)
//   MESA_SESSION  this session's id (or --session); required for wait and ownership
//   MESA_TOKEN    only needed when MESA_URL is not localhost
//   MESA_ENV      "sandbox" for the dummy board (docs/SANDBOX.md); the server decides, the CLI only passes flags
//
// Output is JSON on stdout for sessions (MESA_SESSION set, --json, or stdout not a terminal)
// and a short human summary in a terminal (--human forces it). Errors go to stderr with exit
// code 1 (2 for usage, 3 when a --wait ends without the hoped-for outcome).

import { readFileSync } from "node:fs";
import { basename, extname } from "node:path";
import process from "node:process";

const HELP = `mesa <command> [options]

Sessions
  mesa session [--label L] [--project P]          register / heartbeat this session
  mesa wait [--timeout S] [--loop|--once] [--manual-ack]
                                                   long-poll for wake events, one JSON line each (id = cursor), then ack;
                                                   --once returns after one poll; --manual-ack leaves the ack to "mesa ack"
  mesa ack <cursor>                                acknowledge events up to <cursor> (after handling them)

Tickets
  mesa ticket ask --title T [--body B] [--option "A:label[:detail]"]... [--recommend A --why W] [--project P] [--ref t12]...
                  [--wait [--timeout S]]       --wait blocks until Andrés answers and prints { ticket, answer }
  mesa ticket reply <id|ref> --body B [--ask] [--option ...] [--recommend A --why W]
                  a reply is informational unless it has options or --ask: only then does the ticket go to "Te espera";
                  --option makes a 1-step question card (2-6 options, keys A-F)
  mesa ticket questions <id|ref> --json -      one question card: {body, questions:[{text, options:[{key,label,detail?}],
                  recommend, why}]} from stdin; 1-6 questions of 2-6 options (keys A-F); the ticket goes to "Te espera".
                  Each question stays open until Andrés answers it or you withdraw it (ticket.answered carries
                  answers [{questionId, n, chosen, label, text}] and openLeft)
  mesa ticket question withdraw <tq id> --why W  withdraw an open question (moot, or his words already answered it); 409 if not open
  mesa ticket checklist <id|ref> --json -      a checklist of manual steps for Andrés: {body, steps:[{text, detail?}]} from stdin; 1-30
                  steps, text one line (300), detail optional Markdown (4000, code fences get a copy button). It is a message of
                  yours; the ticket goes to "Te espera" until every step is done ("Hacer pasos · 2 de 5"). Each tick or untick
                  of Andrés wakes you with ticket.checklist {ref, ticketRef, messageId, stepId, n, done, doneCount, total, allDone}
  mesa ticket check <id|ref> <step> [--undo] [--note "<one line>"]   mark a step you verified yourself ("verificado por Claude" + the
                  note, no wake); --undo reopens it. <step> is a step id (ck_..), <message id>/<n>, or a bare n while only one of
                  the ticket's checklists has it (else a 400 "ambiguous" names the options); "mesa ticket context" lists the steps
  mesa ticket plan <id|ref> --action "kind:source:direct|needs_ok:label"...
  mesa ticket claim <id|ref>      take an Andrés request and start work
  mesa ticket close <id|ref>
  mesa ticket pause <id|ref> --reason R [--until-ticket tN]
                  "En pausa": blocked on something else (another ticket, a third party, a date: put the date in R). R is required.
                  --until-ticket names an open ticket (not this one): when it closes (close or fold) this one resumes by itself,
                  back to Claude, and its owner wakes with ticket.resumed. From any open status; 400 on a bad ticket, 409 closed
  mesa ticket ongoing <id|ref> --reason R        "En proceso": going on with nobody active (CI, a third party). R is required
  mesa ticket resume <id|ref>                    paused/ongoing -> working, no wake. 409 unless paused or ongoing. Andrés replying,
                  you asking or planning, or a claim also end the pause
  mesa ticket reopen <id|ref> [--reason R]       closed -> waiting_claude (the owner wakes with ticket.reopened)
  mesa ticket fold <primary> <ref>... --why W   (lead, on ticket.batch) group same-topic tickets under one owner: their cards and
                  refs move to <primary>, which gets "Agrupé: … porque W"; each folded ticket closes with "Agrupado en <primary>: W"
                  and no wake. 409 on a closed, sample or Claude-asked ticket, or when <ref> is <primary>
  mesa ticket unfold <primary> <ref>              (lead, when Andrés says "separa tN") split a folded ticket out again: it reopens
                  unclaimed, its card comes back, and the lead gets ticket.created with splitFrom. 409 if it was not folded there
  mesa ticket action <actionId> --state running|done|failed
  mesa ticket show <id|ref>
  mesa ticket context <ref> [--messages N]     resume payload: brief, plan, last messages, team, handoffs, approvals, findings
  mesa ticket brief <ref> [--body -] [--goal G] [--step S] [--next N] [--decision D]... [--question Q]...
  mesa ticket list [--open]
  mesa ticket attach <ref> <file> [--message <id>]   upload a file to the ticket (25 MB max) and print the attachment JSON; a PDF
                  gets a "Revisar" button in the thread that opens the PDF review view (/tickets/<ref>/pdf/<attId>)
  mesa ticket annotations <ref> [--att <attId>] [--open]   Andrés's marks on the ticket's PDFs, in reading order, as JSON:
                  [{id, attachmentId, page, kind highlight|note|rect|ellipse|arrow, rect {x,y,w,h} in page units (PDF points,
                  top left origin), geometry, quote, body, author, state open|resolved, replies [{author, body, createdAt}]}]
                  A ticket.annotations wake says which ones he just sent (annotationIds)
  mesa ticket annotation-reply <ref> <annId> --body -   Claude's reply on one mark (he sees it live in the panel)

Salidas (outgoing messages; nothing is sent without Andrés's approval)
  mesa salida propose --source slack|basecamp|github|calendar --dest JSON --body B [--title T] [--context C] [--ticket ID] [--link "source:label[:url]"]... [--expires ISO]
                  [--wait-release [--timeout S]]  blocks until salida.released (exit 0) or denied/expired/withdrawn (exit 3)
  mesa salida version <id> --body B [--turn TURN_ID] [--chip "Más corto"]
  mesa salida sent <id> [--permalink URL]          only after salida.released, for a Slack salida in mode send ("Claude lo envía"),
                                                   Basecamp and GitHub
  mesa salida sent <id> --simulated                sandbox only (MESA_ENV=sandbox): nothing was sent; Mesa records
                                                   sandbox://<source>/<id>. Refused in live
  mesa salida drafted <id>                         Slack salida in mode draft (the default): its text is now a draft in Andrés's Slack
                                                   (slack_send_message_draft); status draft_created, closed by his "Ya lo envié"
  mesa salida drafted <id> --simulated             sandbox only: no draft was created; Mesa records sandbox://slack/<id>
  mesa salida failed <id> --error E
  mesa salida hold <id> --reason R               released but the source is down (waits as "Aprobar al volver")
  mesa salida bounce <id> --reason R             the thread changed: back to Andrés for a new approval
  mesa salida deleted <id> | restored <id>
  mesa salida withdraw <id> --reason R           (lead) take a stale draft/pending salida back: final status "withdrawn", never sent,
                  the reason shows on its card ("Retirada · R"); not a deny (no wake, no Andrés turn). Any other status: 409
  mesa salida show <id>
  mesa salida list [--status pending,scheduled]

Agents (ephemeral: everything they need lives on the ticket)
  mesa ticket handoff <ref> ...                 same as mesa handoff
  mesa handoff <ref> --agent A --status done|paused|blocked --body - [--role R] [--done D] [--left L] [--branch B] [--pr P] [--file F]...
  mesa handoffs [--agent A] [--ticket ref]
  mesa team add|join <ref> --agent <role>-<ref>[-k] --role R [--owner]
  mesa team retire|spent <name> [--reason R]
  mesa team list [--status live|retired] [--ticket ref]

Reviews and approvals
  mesa finding upsert <ref> --json -           {repo, pr, n?, label, at, anchor, summary, explanation, state, sha, ghCommentId};
                  a new finding needs label and summary; a state-only upsert needs only {repo, pr, n, state}
                  (omitted fields keep their stored values)
  mesa finding list <ref>
  mesa review open <ref> --repo owner/name --pr N --sha <head>   open/refresh the review card (also with 0 findings; new head reopens an approved one)
  mesa review list [--ticket ref] | show <reviewId>
  mesa review close <reviewId> --reason R        (lead) close a stale open review card ("Cerrada · R"); its ticket leaves Te espera when
                  nothing else is owed. 409 unless the review is open; "review open" at any head reopens it
                  a closed review ticket reopens by itself when its PR gets a new head (GitHub poll or review open)
  mesa sandbox push <ref> [--sha <sha>]          sandbox only: simulate a push to the PR of the review on <ref> (random sha
                                                   when omitted); the same server function as the poll. Refused in live
  mesa approval show <id>

Lead (the lead session only)
  mesa lead focus [<ref>|--clear]                 name the ticket the lead is acting on, so its permission prompts
                                                   (MESA_APPROVAL_LEAD=1) are filed to that ticket instead of Hoy, Permisos;
                                                   no argument prints the current focus; --clear removes it; it lapses
                                                   2 h after the last set (run it again to renew)

Sources and sweep (github|github_project|slack|basecamp|engram|calendar)
  mesa source get [<source>]                    sweep state + health (all sources without <source>)
  mesa source set <source> [--health ok|degraded|down] [--note N] [--watermark W] [--checked ISO|now]
                  [--new ISO|now] [--backoff-until ISO|none] [--cadence SECONDS]
                  [--error-count N] [--last-error MSG|none]
  mesa sweep [--source slack|basecamp|github]...        same as "Barrer ahora"

Calendario (Andrés's Google Calendar, read only: the server polls his private iCal feed; creating is a salida)
  mesa calendar list [--from YYYY-MM-DD] [--to YYYY-MM-DD]   stored events (Bogota days, default this week and the next) + health
  mesa calendar next                               the next meeting (or the one in progress), null when none
  mesa calendar status                             connected?, health, last refresh (no events)
  mesa calendar free [--day YYYY-MM-DD] [--minutes 30] [--open 08:00] [--close 19:00]
                                                   free gaps of a Bogota day inside working hours (today starts now)
  mesa calendar people                             people on the stored events (email, name, shared meetings): find an invitee's address
  mesa calendar refresh                            read the feed now (409 in sandbox or without MESA_GCAL_ICS_URL)
  mesa calendar propose --title T --start ISO --end ISO [--zone America/Bogota] [--invitee EMAIL]... [--no-meet]
                  [--repeat "RRULE:FREQ=WEEKLY;BYDAY=WE"] [--description D] [--calendar primary] [--ticket ID] [--context C] [--wait-release [--timeout S]]
                                                   the exact event as a salida (source calendar); times carry their offset,
                                                   e.g. 2026-11-12T10:00:00-05:00. The lead creates it after Andrés approves.
                                                   --repeat makes it a series: the exact RRULE (FREQ, INTERVAL, BYDAY, BYMONTHDAY,
                                                   BYMONTH, COUNT or UNTIL, WKST), uppercase, the start on a BYDAY day; the card
                                                   says it in Spanish. An invalid rule comes back as the server's 400.

GitHub (server side, with the gh login; Mesa never writes reviews or comments)
  mesa github sync                                 poll notifications + review requests, push/pull the Project now
  mesa github status                               Project ids (settings) and github / github_project health
  mesa github import-reviews                       read pr-monitor's state file (read only) into Mesa reviews

Tasks (Tablero)
  mesa task create --title T [--body B] [--project P] [--station S] [--source claude] [--kind K] [--note-only]
                                                   a card; without --note-only it is handed to Claude: a linked ticket and
                                                   ticket.created to the lead. Agents adding a card (create_task) pass --note-only
  mesa task dispatch <id> [--kind review|request|investigation|reply]
                                                   "Dárselo a Claude" on an existing card (idempotent; samples refused)
  mesa task list [--station S] [--source S]
  mesa task move <id> <station>                    inbox|todo|doing|waiting|done (Sin sincronizar until the Project acks)

Items and memory
  mesa item upsert --json JSON                     ItemInput (source, externalId, kind, title, ...); an ignored project's
                                                   item is not stored and returns { ignored: true }
  mesa item skip <id>                              "Saltar": done, waitOn none, skippedAt set; no upsert reopens it
  mesa item pr-notice <id>                         the writer's verdict on a Slack PR message: a notice, no reply
                                                   (Hecho, one line on the PR ticket, no salida); idempotent
  mesa ignore list                                 ignored projects [{ id, source, project, label, hidden }] (sweeper: skip them)
  mesa ignore add <github|slack|basecamp|claude|*> <projectKey> [--label L]
                                                   projectKey: GitHub owner/repo, Slack channel id, Basecamp project name
  mesa ignore remove <id> | remove <source> <projectKey>
  mesa engram link --entity ticket:<id> --project P [--topic KEY] [--obs ID]

--body - reads the body from stdin. --session overrides MESA_SESSION. --json / --human pick the output.`;

// ---------- args ----------
function parse(argv) {
  const pos = [];
  const opt = {};
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a.startsWith("--")) {
      const key = a.slice(2);
      const next = argv[i + 1];
      const val = next === undefined || (next.startsWith("--") && next !== "-") ? true : (i++, next);
      if (key in opt) opt[key] = [].concat(opt[key], val);
      else opt[key] = val;
    } else pos.push(a);
  }
  return { pos, opt };
}
const list = (v) => (v === undefined ? [] : [].concat(v));
const usage = (msg) => {
  process.stderr.write(`mesa: ${msg}\n\n${HELP}\n`);
  process.exit(2);
};
const need = (v, name) => (v === undefined || v === true || v === "" ? usage(`missing ${name}`) : v);

// JSON option value. Some shells (the Bash tool on Windows) strip one level of backslashes from a
// heredoc, so "\\d" arrives as "\d", which is not valid JSON. When the strict parse fails, retry once
// with each lone backslash (not a valid JSON escape) doubled; valid JSON is always parsed as written.
// On a second failure the error is the strict parser's message, which names the position.
function parseJsonOpt(raw, flag) {
  try {
    return JSON.parse(raw);
  } catch (err) {
    try {
      return JSON.parse(raw.replace(/\\([\s\S]?)/g, (m, c) => (c !== "" && '"\\/bfnrtu'.includes(c) ? m : `\\\\${c}`)));
    } catch {
      return usage(`${flag} must be JSON: ${err instanceof Error ? err.message : String(err)}`);
    }
  }
}

let stdinCache;
function text(v, name) {
  const s = need(v, name);
  if (s !== "-") return String(s);
  stdinCache ??= readFileSync(0, "utf8");
  return stdinCache.replace(/\r?\n$/, "");
}

function options(opt) {
  const opts = list(opt.option).map((o) => {
    const [key, label, ...rest] = String(o).split(":");
    if (!key || !label) usage(`bad --option "${o}" (want "A:label[:detail]")`);
    return { key, label, detail: rest.length ? rest.join(":") : undefined };
  });
  return opts.length ? opts : undefined;
}

// ---------- http ----------
const BASE = (process.env.MESA_URL ?? "http://127.0.0.1:8790").replace(/\/$/, "");
async function call(method, path, body) {
  const headers = { "content-type": "application/json", "x-mesa-client": "cli" }; // the server does not count CLI writes as Andrés's interaction
  if (process.env.MESA_TOKEN) headers["x-mesa-token"] = process.env.MESA_TOKEN;
  let res;
  try {
    res = await fetch(BASE + path, { method, headers, body: body === undefined ? undefined : JSON.stringify(body) });
  } catch (err) {
    process.stderr.write(`mesa: cannot reach ${BASE} (${err.cause?.code ?? err.message}). Is "pnpm dev" running?\n`);
    process.exit(1);
  }
  const data = res.status === 204 ? null : await res.json().catch(() => null);
  if (!res.ok) {
    process.stderr.write(`mesa: ${res.status} ${data?.error?.message ?? res.statusText}\n`);
    process.exit(1);
  }
  return data;
}
// Multipart upload (ticket attach): no content-type header, fetch sets the boundary.
const MIME = { ".pdf": "application/pdf", ".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".gif": "image/gif", ".webp": "image/webp", ".txt": "text/plain", ".md": "text/markdown", ".csv": "text/csv", ".json": "application/json" };
async function upload(path, form) {
  const headers = { "x-mesa-client": "cli" };
  if (process.env.MESA_TOKEN) headers["x-mesa-token"] = process.env.MESA_TOKEN;
  let res;
  try {
    res = await fetch(BASE + path, { method: "POST", headers, body: form });
  } catch (err) {
    process.stderr.write(`mesa: cannot reach ${BASE} (${err.cause?.code ?? err.message}). Is "pnpm dev" running?\n`);
    process.exit(1);
  }
  const data = await res.json().catch(() => null);
  if (!res.ok) {
    process.stderr.write(`mesa: ${res.status} ${data?.error?.message ?? res.statusText}\n`);
    process.exit(1);
  }
  return data;
}
let HUMAN = false;
const out = (x) => process.stdout.write((HUMAN ? human(x) : JSON.stringify(x, null, 2)) + "\n");

// ---------- human output ----------
const pick = (o, keys) => keys.map((k) => o?.[k]).filter((v) => v !== undefined && v !== null && v !== "");
function line(o) {
  if (o === null || typeof o !== "object") return String(o);
  const id = pick(o, ["ref", "id", "name", "source"])[0] ?? "";
  const what = pick(o, ["title", "summary", "label", "body", "kind"])[0] ?? "";
  const state = pick(o, ["status", "state", "health", "station", "syncState"])[0] ?? "";
  return [id, state && `[${state}]`, String(what).split("\n")[0]].filter(Boolean).join("  ");
}
function human(x) {
  if (x === null || x === undefined) return "ok";
  if (Array.isArray(x)) return x.length ? x.map(line).join("\n") : "(none)";
  if (typeof x !== "object") return String(x);
  const keys = Object.keys(x);
  // Named wrappers ({ brief }, { handoffs }, { source, resumed }, ...): unwrap the object.
  if (!("id" in x) && keys.length <= 3 && keys.some((k) => typeof x[k] === "object" && x[k] !== null)) {
    const k = keys.find((j) => typeof x[j] === "object" && x[j] !== null);
    const rest = keys.filter((j) => j !== k).map((j) => `${j}: ${JSON.stringify(x[j])}`);
    return [human(x[k]), ...rest].join("\n");
  }
  const extra = [];
  if (Array.isArray(x.messages) && x.messages.length) extra.push(`${x.messages.length} messages; last: ${String(x.messages.at(-1).body).split("\n")[0]}`);
  if (Array.isArray(x.versions)) extra.push(`v${x.currentVersion} of ${x.versions.length}`);
  if (x.url) extra.push(String(x.url));
  return [line(x), ...extra.map((e) => `  ${e}`)].join("\n");
}
const enc = encodeURIComponent;

// ---------- waiters ----------
// Both poll /api/wait in peek mode (never acks, so the session's own `mesa wait` still gets
// every event) and re-read the entity after each wake or timeout: the state is the truth,
// the event is only a hint. A timeout of 0 waits forever.
const fail3 = (msg) => {
  process.stderr.write(`mesa: ${msg}\n`);
  process.exitCode = 3;
};
async function peekLoop(sessionId, timeoutS, done) {
  const deadline = timeoutS > 0 ? Date.now() + timeoutS * 1000 : Infinity;
  let after;
  for (;;) {
    const result = await done();
    if (result) return result;
    const left = deadline - Date.now();
    if (left <= 0) return null;
    const t = Math.max(1, Math.min(25, Math.ceil(left / 1000)));
    const q = `session=${enc(sessionId)}&peek=1&timeout=${t}${after === undefined ? "" : `&after=${after}`}`;
    const r = await call("GET", `/api/wait?${q}`);
    after = r.cursor;
  }
}

async function waitAnswer(ticket, sessionId, timeoutS) {
  const asked = ticket.messages?.at(-1)?.createdAt ?? ticket.createdAt;
  const head = (t) => ({ id: t.id, ref: t.ref, status: t.status });
  const res = await peekLoop(sessionId, timeoutS, async () => {
    const t = await call("GET", `/api/tickets/${enc(ticket.id)}`);
    const answer = t.messages.filter((m) => m.author === "andres" && m.createdAt >= asked).at(-1);
    if (answer) {
      const answers = (t.questions ?? [])
        .filter((q) => q.answerMessageId === answer.id)
        .map((q) => ({ questionId: q.id, n: q.n, chosen: q.chosen, text: q.answerText }));
      return { ticket: head(t), answer: { body: answer.body, chosen: answer.chosen, answers, at: answer.createdAt } };
    }
    if (t.status === "closed") return { ticket: head(t), answer: null, closed: true };
    return null;
  });
  if (!res) {
    fail3(`no answer on ${ticket.ref} within ${timeoutS} s`);
    return { ticket: head(ticket), answer: null, timedOut: true };
  }
  if (res.closed) fail3(`${ticket.ref} was closed without an answer`);
  return res;
}

async function waitRelease(salida, sessionId, timeoutS) {
  const res = await peekLoop(sessionId, timeoutS, async () => {
    const s = await call("GET", `/api/salidas/${enc(salida.id)}`);
    if ((s.status === "sending" && s.releasedAt) || s.status === "draft_created" || s.status === "sent") return { released: true, salida: s };
    if (["denied", "expired", "deleted", "withdrawn"].includes(s.status)) return { released: false, salida: s };
    return null;
  });
  if (!res) {
    fail3(`salida ${salida.id} not released within ${timeoutS} s`);
    return { released: false, timedOut: true, salida: { id: salida.id } };
  }
  if (!res.released) fail3(`salida ${salida.id} is ${res.salida.status}: do not send it`);
  return res;
}

// ---------- commands ----------
async function main() {
  const argv = process.argv.slice(2);
  if (argv[0] === "ticket" && argv[1] === "handoff") argv.splice(0, 2, "handoff");
  const { pos, opt } = parse(argv);
  const [group, cmd, id] = pos;
  const session = opt.session ?? process.env.MESA_SESSION;
  HUMAN = opt.human ? true : opt.json ? false : Boolean(process.stdout.isTTY) && !session;
  const needSession = () => need(session, "MESA_SESSION (or --session)");

  if (!group || opt.help || group === "help") return void process.stdout.write(HELP + "\n");

  switch (group) {
    case "session":
      return out(await call("POST", "/api/sessions", { id: needSession(), label: opt.label, project: opt.project, cwd: process.cwd() }));

    case "wait": {
      const s = needSession();
      const timeout = Number(opt.timeout ?? 25);
      // Without --loop: keep polling until the first batch arrives, print it, ack, exit.
      for (;;) {
        const r = await call("GET", `/api/wait?session=${enc(s)}&timeout=${timeout}`);
        if (!r.events.length) {
          if (opt.once) return;
          continue;
        }
        for (const e of r.events) process.stdout.write(JSON.stringify(e) + "\n");
        // Delivery is at least once: without --manual-ack the batch is acked once printed.
        if (opt["manual-ack"]) return;
        await call("POST", "/api/wait/ack", { session: s, cursor: r.cursor });
        if (!opt.loop) return;
      }
    }

    case "ack":
      return out(await call("POST", "/api/wait/ack", { session: needSession(), cursor: Number(need(cmd, "<cursor>")) }));

    case "ticket":
      switch (cmd) {
        case "ask": {
          const created = await call("POST", "/api/tickets", {
            direction: "claude_asks",
            title: text(opt.title, "--title"),
            body: opt.body === undefined ? undefined : text(opt.body, "--body"),
            options: options(opt),
            recommended: opt.recommend,
            recommendation: opt.why,
            project: opt.project,
            ownerSession: needSession(),
            refs: list(opt.ref).map((r) => ({ refType: "ticket", target: r })),
          });
          if (!opt.wait) return out(created);
          return out(await waitAnswer(created, needSession(), Number(opt.timeout ?? 0)));
        }
        case "reply":
          return out(
            await call("POST", `/api/tickets/${enc(need(id, "<id>"))}/messages`, {
              author: "claude",
              body: text(opt.body, "--body"),
              options: options(opt),
              recommended: opt.recommend,
              recommendation: opt.why,
              ask: opt.ask ? true : undefined,
              session,
            }),
          );
        case "questions": {
          const raw = parseJsonOpt(text(opt.json, "--json"), "--json");
          if (!raw || typeof raw !== "object" || !Array.isArray(raw.questions)) usage('--json wants {body, questions:[{text, options:[{key,label}], recommend, why}]}');
          const questions = raw.questions.map((q) => ({
            text: q?.text,
            options: q?.options,
            recommended: q?.recommend ?? q?.recommended,
            recommendation: q?.why ?? q?.recommendation,
          }));
          return out(
            await call("POST", `/api/tickets/${enc(need(id, "<id>"))}/messages`, {
              author: "claude",
              body: typeof raw.body === "string" ? raw.body : undefined,
              questions,
              refs: Array.isArray(raw.refs) ? raw.refs.map((r) => ({ refType: "ticket", target: String(r) })) : undefined,
              session,
            }),
          );
        }
        case "checklist": {
          const raw = parseJsonOpt(text(opt.json, "--json"), "--json");
          if (!raw || typeof raw !== "object" || !Array.isArray(raw.steps)) usage('--json wants {body, steps:[{text, detail?}]}');
          const steps = raw.steps.map((x) => (typeof x === "string" ? { text: x } : { text: x?.text, detail: x?.detail }));
          return out(
            await call("POST", `/api/tickets/${enc(need(id, "<id>"))}/checklist`, {
              body: typeof raw.body === "string" ? raw.body : undefined,
              steps,
              refs: Array.isArray(raw.refs) ? raw.refs.map((r) => ({ refType: "ticket", target: String(r) })) : undefined,
              session,
            }),
          );
        }
        case "check": {
          // "--undo 2" would swallow the step as the flag's value: read it back.
          const step = String(need(pos[3] ?? (typeof opt.undo === "string" ? opt.undo : undefined), "<step>")).replace("/", ".");
          if (opt.undo && opt.note !== undefined) usage("--note goes with a mark, not with --undo");
          return out(
            await call("PUT", `/api/tickets/${enc(need(id, "<id>"))}/steps/${enc(step)}`, {
              done: !opt.undo,
              note: opt.note === undefined ? undefined : text(opt.note, "--note"),
              session,
            }),
          );
        }
        case "question": {
          if (id !== "withdraw") usage(`unknown ticket question command "${id ?? ""}" (want withdraw)`);
          return out(
            await call("POST", `/api/questions/${enc(need(pos[3], "<tq id>"))}/withdraw`, { reason: text(opt.why, "--why"), session }),
          );
        }
        case "plan": {
          const actions = list(opt.action).map((a) => {
            const [kind, source, mode, ...label] = String(a).split(":");
            if (!kind || !source || !["direct", "needs_ok"].includes(mode) || !label.length) {
              usage(`bad --action "${a}" (want "kind:source:direct|needs_ok:label")`);
            }
            return { kind, source, mode, label: label.join(":") };
          });
          if (!actions.length) usage("plan needs at least one --action");
          return out(await call("POST", `/api/tickets/${enc(need(id, "<id>"))}/plan`, { actions, session }));
        }
        case "claim":
          return out(await call("POST", `/api/tickets/${enc(need(id, "<id>"))}/transition`, { event: "claim", session: needSession() }));
        case "close":
          return out(await call("POST", `/api/tickets/${enc(need(id, "<id>"))}/transition`, { event: "close", by: "claude", session }));
        case "pause":
        case "ongoing": {
          const until = opt["until-ticket"];
          if (until !== undefined && cmd === "ongoing") usage("--until-ticket only goes with pause");
          if (until !== undefined && (typeof until !== "string" || !until)) usage("--until-ticket wants one ticket ref (tN)");
          return out(
            await call("POST", `/api/tickets/${enc(need(id, "<id>"))}/transition`, { event: cmd, by: "claude", reason: text(opt.reason, "--reason"), untilTicket: until, session }),
          );
        }
        case "resume":
          return out(await call("POST", `/api/tickets/${enc(need(id, "<id>"))}/transition`, { event: "resume", by: "claude", session }));
        case "reopen":
          return out(
            await call("POST", `/api/tickets/${enc(need(id, "<id>"))}/transition`, { event: "reopen", by: "claude", reason: typeof opt.reason === "string" ? opt.reason : undefined }),
          );
        case "fold": {
          const from = pos.slice(3).map(String);
          if (!from.length) usage("fold needs at least one <ref> to fold into <primary>");
          return out(
            await call("POST", `/api/tickets/${enc(need(id, "<primary>"))}/fold`, { from, why: text(opt.why, "--why"), session }),
          );
        }
        case "unfold":
          return out(await call("POST", `/api/tickets/${enc(need(id, "<primary>"))}/unfold`, { ticket: need(pos[3], "<ref>") }));
        case "action":
          return out(await call("PATCH", `/api/actions/${enc(need(id, "<actionId>"))}`, { state: need(opt.state, "--state") }));
        case "show":
          return out(await call("GET", `/api/tickets/${enc(need(id, "<id>"))}`));
        case "context":
          return out(await call("GET", `/api/tickets/${enc(need(id, "<ref>"))}/context${opt.messages ? `?messages=${enc(opt.messages)}` : ""}`));
        case "brief": {
          const b = {
            body: opt.body === undefined ? undefined : text(opt.body, "--body"),
            goal: opt.goal,
            planStep: opt.step,
            nextAction: opt.next,
            decisions: opt.decision === undefined ? undefined : list(opt.decision).map(String),
            openQuestions: opt.question === undefined ? undefined : list(opt.question).map(String),
            updatedBy: opt.agent ?? process.env.MESA_AGENT ?? session,
          };
          const method = Object.values(b).some((v) => v !== undefined && v !== b.updatedBy) ? "PUT" : "GET";
          return out(await call(method, `/api/tickets/${enc(need(id, "<ref>"))}/brief`, method === "PUT" ? b : undefined));
        }
        case "attach": {
          const file = need(pos[3], "<file>");
          let data;
          try {
            data = readFileSync(String(file));
          } catch (err) {
            process.stderr.write(`mesa: cannot read ${file} (${err.code ?? err.message})\n`);
            process.exit(1);
          }
          const name = basename(String(file));
          const form = new FormData();
          form.set("file", new File([data], name, { type: MIME[extname(name).toLowerCase()] ?? "application/octet-stream" }));
          if (opt.message !== undefined) form.set("messageId", String(need(opt.message, "--message")));
          return out(await upload(`/api/tickets/${enc(need(id, "<ref>"))}/attachments`, form));
        }
        case "annotations": {
          const q = [opt.att ? `att=${enc(need(opt.att, "--att"))}` : "", opt.open ? "open=1" : ""].filter(Boolean).join("&");
          return out(await call("GET", `/api/tickets/${enc(need(id, "<ref>"))}/annotations${q ? `?${q}` : ""}`));
        }
        case "annotation-reply":
          return out(
            await call("POST", `/api/tickets/${enc(need(id, "<ref>"))}/annotations/${enc(need(pos[3], "<annId>"))}/replies`, { body: text(opt.body, "--body") }),
          );
        case "list":
          return out(await call("GET", `/api/tickets${opt.open ? "?open=1" : ""}`));
      }
      return usage(`unknown ticket command "${cmd ?? ""}"`);

    case "salida":
      switch (cmd) {
        case "propose": {
          const destination = parseJsonOpt(String(need(opt.dest, "--dest")), "--dest");
          const created = await call("POST", "/api/salidas", {
            source: need(opt.source, "--source"),
            destination,
            body: text(opt.body, "--body"),
            title: opt.title,
            context: opt.context,
            ticketId: opt.ticket,
            expiresAt: opt.expires,
            ownerSession: needSession(),
            links: list(opt.link).map((l) => {
              const [source, label, ...url] = String(l).split(":");
              return { source, label, url: url.length ? url.join(":") : undefined };
            }),
          });
          if (!opt["wait-release"]) return out(created);
          return out(await waitRelease(created, needSession(), Number(opt.timeout ?? 0)));
        }
        case "version":
          return out(
            await call("POST", `/api/salidas/${enc(need(id, "<id>"))}/versions`, {
              body: text(opt.body, "--body"),
              author: "claude",
              turnId: opt.turn,
              chipLabel: opt.chip,
            }),
          );
        case "sent": {
          // --simulated is a flag; `sent --simulated <id>` would otherwise read the id as its value.
          const sid = id ?? (typeof opt.simulated === "string" ? opt.simulated : undefined);
          const simulated = opt.simulated !== undefined;
          if (simulated && opt.permalink) usage("--simulated takes no --permalink: Mesa records sandbox://<source>/<id>");
          return out(
            await call("POST", `/api/salidas/${enc(need(sid, "<id>"))}/transition`, simulated ? { type: "sent", simulated: true } : { type: "sent", permalink: opt.permalink }),
          );
        }
        case "drafted": {
          // --simulated is a flag; `drafted --simulated <id>` would otherwise read the id as its value.
          const did = id ?? (typeof opt.simulated === "string" ? opt.simulated : undefined);
          const simulated = opt.simulated !== undefined;
          return out(await call("POST", `/api/salidas/${enc(need(did, "<id>"))}/transition`, simulated ? { type: "drafted", simulated: true } : { type: "drafted" }));
        }
        case "failed":
          return out(await call("POST", `/api/salidas/${enc(need(id, "<id>"))}/transition`, { type: "failed", error: text(opt.error, "--error") }));
        case "hold":
        case "bounce":
          return out(await call("POST", `/api/salidas/${enc(need(id, "<id>"))}/transition`, { type: cmd, reason: text(opt.reason, "--reason") }));
        case "withdraw":
          return out(await call("POST", `/api/salidas/${enc(need(id, "<id>"))}/transition`, { type: "withdraw", reason: text(opt.reason, "--reason") }));
        case "deleted":
        case "restored":
          return out(await call("POST", `/api/salidas/${enc(need(id, "<id>"))}/transition`, { type: cmd }));
        case "show":
          return out(await call("GET", `/api/salidas/${enc(need(id, "<id>"))}`));
        case "list":
          return out(await call("GET", `/api/salidas${opt.status ? `?status=${enc(opt.status)}` : ""}`));
      }
      return usage(`unknown salida command "${cmd ?? ""}"`);

    case "handoff": {
      const ref = need(cmd, "<ref>");
      const artifacts = {};
      if (opt.branch) artifacts.branch = opt.branch;
      if (opt.pr) artifacts.pr = String(opt.pr);
      if (opt.file) artifacts.files = list(opt.file).map(String);
      return out(
        await call("POST", `/api/tickets/${enc(ref)}/handoffs`, {
          agent: need(opt.agent ?? process.env.MESA_AGENT, "--agent"),
          role: opt.role,
          status: need(opt.status, "--status"),
          body: opt.body === undefined ? undefined : text(opt.body, "--body"),
          done: opt.done,
          remaining: opt.left,
          artifacts,
        }),
      );
    }

    case "handoffs": {
      const q = new URLSearchParams();
      if (opt.agent) q.set("agent", opt.agent);
      if (opt.ticket) q.set("ticket", opt.ticket);
      return out(await call("GET", `/api/handoffs?${q}`));
    }

    case "team":
      switch (cmd) {
        case "add":
        case "join":
          return out(
            await call("POST", "/api/team", { ticketRef: need(id, "<ref>"), agent: need(opt.agent, "--agent"), role: need(opt.role, "--role"), owner: Boolean(opt.owner) }),
          );
        case "retire":
        case "spent":
          return out(await call("POST", `/api/team/${enc(need(id, "<name>"))}/retire`, opt.reason ? { reason: String(opt.reason) } : {}));
        case "list": {
          const q = new URLSearchParams();
          if (opt.status) q.set("status", opt.status);
          if (opt.ticket) q.set("ticket", opt.ticket);
          return out(await call("GET", `/api/team?${q}`));
        }
      }
      return usage(`unknown team command "${cmd ?? ""}"`);

    case "finding":
      switch (cmd) {
        case "upsert": {
          const f = parseJsonOpt(text(opt.json, "--json"), "--json");
          return out(await call("POST", `/api/tickets/${enc(need(id, "<ref>"))}/findings`, f));
        }
        case "list":
          return out(await call("GET", `/api/tickets/${enc(need(id, "<ref>"))}/findings`));
      }
      return usage(`unknown finding command "${cmd ?? ""}"`);

    case "review":
      if (cmd === "open") {
        const pr = Number(need(opt.pr, "--pr"));
        if (!Number.isInteger(pr) || pr <= 0) usage("--pr must be a positive integer");
        return out(await call("POST", `/api/tickets/${enc(need(id, "<ref>"))}/reviews`, { repo: need(opt.repo, "--repo"), pr, sha: need(opt.sha, "--sha") }));
      }
      if (cmd === "show") return out(await call("GET", `/api/reviews/${enc(need(id, "<reviewId>"))}`));
      if (cmd === "close") return out(await call("POST", `/api/reviews/${enc(need(id, "<reviewId>"))}/close`, { reason: text(opt.reason, "--reason") }));
      if (cmd !== "list") return usage(`unknown review command "${cmd ?? ""}"`);
      return out(await call("GET", `/api/reviews${opt.ticket ? `?ticket=${enc(opt.ticket)}` : ""}`));

    case "sandbox":
      if (cmd !== "push") return usage(`unknown sandbox command "${cmd ?? ""}"`);
      return out(await call("POST", "/api/sandbox/push", { ref: need(id, "<ref>"), sha: typeof opt.sha === "string" ? opt.sha : undefined }));

    case "lead":
      if (cmd !== "focus") return usage(`unknown lead command "${cmd ?? ""}"`);
      if (opt.clear !== undefined) return out(await call("DELETE", "/api/lead/focus"));
      if (id === undefined) return out(await call("GET", "/api/lead/focus"));
      return out(await call("PUT", "/api/lead/focus", { ticket: id }));

    case "approval":
      if (cmd !== "show") return usage(`unknown approval command "${cmd ?? ""}"`);
      return out(await call("GET", `/api/approvals/${enc(need(id, "<id>"))}`));

    case "source": {
      if (cmd === "get") return out(await call("GET", id ? `/api/sources/${enc(id)}` : "/api/sources"));
      if (cmd !== "set") return usage(`unknown source command "${cmd ?? ""}"`);
      const when = (v) => (v === undefined ? undefined : v === "now" ? new Date().toISOString() : v === "none" ? null : String(v));
      const patch = {
        health: opt.health,
        note: opt.note,
        watermark: opt.watermark === undefined ? undefined : String(opt.watermark),
        lastChecked: when(opt.checked),
        lastNewAt: when(opt.new),
        backoffUntil: when(opt["backoff-until"]),
        cadenceS: opt.cadence === undefined ? undefined : Number(opt.cadence),
        errorCount: opt["error-count"] === undefined ? undefined : Number(opt["error-count"]),
        lastError: opt["last-error"] === undefined ? undefined : opt["last-error"] === "none" ? null : String(opt["last-error"]),
      };
      return out(await call("PATCH", `/api/sources/${enc(need(id, "<source>"))}`, patch));
    }

    case "sweep":
      return out(await call("POST", "/api/sweep", opt.source ? { sources: list(opt.source) } : {}));

    case "calendar": {
      const q = (o) => Object.entries(o).filter(([, v]) => v !== undefined && v !== true).map(([k, v]) => `${k}=${encodeURIComponent(String(v))}`).join("&");
      const qs = (o) => (q(o) ? `?${q(o)}` : "");
      switch (cmd) {
        case "list":
          return out(await call("GET", `/api/calendar${qs({ from: opt.from, to: opt.to })}`));
        case "next":
          return out({ next: (await call("GET", "/api/calendar")).next });
        case "status": {
          const { events, ...rest } = await call("GET", "/api/calendar");
          return out({ ...rest, events: events.length });
        }
        case "free":
          return out(await call("GET", `/api/calendar/free${qs({ day: opt.day, minutes: opt.minutes, open: opt.open, close: opt.close })}`));
        case "people":
          return out(await call("GET", "/api/calendar/people"));
        case "refresh":
          return out(await call("POST", "/api/calendar/refresh", {}));
        case "propose": {
          const invitees = list(opt.invitee).map((e) => String(e).trim().toLowerCase()).filter(Boolean);
          const meet = !opt["no-meet"];
          const lines = [`Título: ${String(need(opt.title, "--title"))}`, `Inicio: ${String(need(opt.start, "--start"))}`, `Fin: ${String(need(opt.end, "--end"))}`, `Zona: ${String(opt.zone ?? "America/Bogota")}`];
          if (invitees.length) lines.push(`Invitados: ${invitees.join(", ")}`);
          lines.push(`Meet: ${meet ? "sí" : "no"}`);
          const recurrence = opt.repeat === undefined ? undefined : opt.repeat === true ? "" : String(opt.repeat).trim();
          if (recurrence !== undefined) lines.push(`Repetir: ${recurrence}`);
          if (opt.description && opt.description !== true) lines.push(`Descripción: ${String(opt.description).trim()}`);
          const created = await call("POST", "/api/salidas", {
            source: "calendar",
            destination: { kind: "calendar_event", calendar: String(opt.calendar ?? "primary"), invitees, meet, ...(recurrence ? { recurrence } : {}), postAs: "Andrés Correa" },
            body: lines.join("\n"),
            title: `Evento: ${String(opt.title)}`,
            context: opt.context,
            ticketId: opt.ticket,
            ownerSession: needSession(),
          });
          if (!opt["wait-release"]) return out(created);
          return out(await waitRelease(created, needSession(), Number(opt.timeout ?? 0)));
        }
      }
      return usage(`unknown calendar command "${cmd ?? ""}"`);
    }

    case "github":
      if (cmd === "sync") return out(await call("POST", "/api/github/sync", {}));
      if (cmd === "status") return out(await call("GET", "/api/github/status"));
      if (cmd === "import-reviews") return out(await call("POST", "/api/github/import-reviews", {}));
      return usage(`unknown github command "${cmd ?? ""}"`);

    case "task": {
      if (cmd === "create") {
        const noteOnly = opt["note-only"] !== undefined && opt["note-only"] !== "false";
        return out(
          await call("POST", "/api/tasks", {
            title: text(opt.title, "--title"),
            source: opt.source ?? "claude",
            excerpt: opt.body === undefined ? undefined : text(opt.body, "--body"),
            project: opt.project,
            station: opt.station,
            kind: opt.kind,
            noteOnly,
          }),
        );
      }
      if (cmd === "dispatch") return out(await call("POST", `/api/tasks/${enc(need(id, "<id>"))}/dispatch`, { kind: opt.kind }));
      if (cmd === "list") {
        const q = new URLSearchParams();
        if (opt.station) q.set("station", opt.station);
        if (opt.source) q.set("source", opt.source);
        return out(await call("GET", `/api/tasks${q.size ? `?${q}` : ""}`));
      }
      if (cmd === "move") return out(await call("POST", `/api/tasks/${enc(need(id, "<id>"))}/move`, { station: need(pos[3], "<station>") }));
      return usage(`unknown task command "${cmd ?? ""}"`);
    }

    case "item":
      if (cmd === "skip") return out(await call("POST", `/api/items/${enc(need(id, "<id>"))}/skip`));
      if (cmd === "pr-notice") return out(await call("POST", `/api/items/${enc(need(id, "<id>"))}/pr-notice`));
      if (cmd !== "upsert") return usage(`unknown item command "${cmd ?? ""}"`);
      return out(await call("POST", "/api/items/upsert", parseJsonOpt(text(opt.json, "--json"), "--json")));

    case "ignore": {
      if (cmd === "list") return out(await call("GET", "/api/ignored-projects"));
      if (cmd === "add") {
        const project = need(pos[3], "<projectKey>");
        return out(await call("POST", "/api/ignored-projects", { source: need(id, "<source>"), project, label: typeof opt.label === "string" ? opt.label : undefined }));
      }
      if (cmd === "remove") {
        let target = need(id, "<id> or <source> <projectKey>");
        if (pos[3] !== undefined) {
          const rows = await call("GET", "/api/ignored-projects");
          const row = rows.find((r) => r.source === target && r.project === pos[3]);
          if (!row) {
            process.stderr.write(`mesa: ${target} ${pos[3]} is not ignored
`);
            process.exit(1);
          }
          target = row.id;
        }
        return out(await call("DELETE", `/api/ignored-projects/${enc(target)}`));
      }
      return usage(`unknown ignore command "${cmd ?? ""}"`);
    }

    case "engram": {
      if (cmd !== "link") return usage(`unknown engram command "${cmd ?? ""}"`);
      const [entityType, entityId] = String(need(opt.entity, "--entity")).split(":");
      return out(
        await call("POST", "/api/engram/links", {
          entityType,
          entityId,
          project: need(opt.project, "--project"),
          topicKey: opt.topic,
          observationId: opt.obs,
        }),
      );
    }
  }
  return usage(`unknown command "${group}"`);
}

main().catch((err) => {
  process.stderr.write(`mesa: ${err.stack ?? err}\n`);
  process.exit(1);
});
